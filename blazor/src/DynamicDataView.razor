@namespace DynamicDataWeb.Blazor
@using Microsoft.AspNetCore.Components
@typeparam TItem
@implements IAsyncDisposable
@if (_loaded) { @ChildContent?.Invoke(_items) } else { @Loading }
@code {
    [Parameter, EditorRequired] public BrowserCollection<TItem> Source { get; set; } = default!;
    [Parameter] public RenderFragment<IReadOnlyList<TItem>>? ChildContent { get; set; }
    [Parameter] public RenderFragment? Loading { get; set; }
    private readonly SemaphoreSlim _gate = new(1, 1);
    private BrowserCollection<TItem>? _source;
    private BrowserSubscription? _subscription;
    private IReadOnlyList<TItem> _items = Array.Empty<TItem>();
    private bool _loaded, _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _gate.WaitAsync();
        try
        {
            if (_disposed || ReferenceEquals(_source, Source)) return;
            if (_subscription is not null) await _subscription.DisposeAsync();
            _source = Source; _loaded = false;
            _subscription = await Source.ObserveItemsAsync(items => _disposed ? Task.CompletedTask : InvokeAsync(() => { _items = items; _loaded = true; StateHasChanged(); }));
        }
        finally { _gate.Release(); }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; await _gate.WaitAsync();
        try { if (_subscription is not null) await _subscription.DisposeAsync(); }
        finally { _gate.Release(); }
    }
}
